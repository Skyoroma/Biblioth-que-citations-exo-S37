{% extends 'base.html.twig' %}

{% block title %}Ajouter une citation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: #f0f2f5;
            margin: 0;
        }

        .example-wrapper {
            max-width: 600px;
            width: 95%;
            margin: 2em auto;
            font: 16px/1.5 system-ui, sans-serif;
            color: #333;
        }

        .form-card {
            background: #fff;
            padding: 2em;
            border-top: 5px solid #4f46e5;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .form-card h1 {
            margin: 0 0 1.2em;
            font-size: 1.6em;
        }

        .form-card form > div {
            margin-bottom: 1.2em;
        }

        .form-card label {
            display: block;
            margin-bottom: 0.4em;
            font-weight: 600;
            color: #444;
        }

        .form-card label.required::after {
            content: " *";
            color: #b91c1c;
        }

        .form-card input:not([type="checkbox"]):not([type="hidden"]),
        .form-card textarea,
        .form-card select {
            width: 100%;
            box-sizing: border-box;
            padding: 0.6em 0.8em;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font: inherit;
            background: #fafafa;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-card textarea {
            min-height: 120px;
            resize: vertical;
        }

        .form-card input:focus,
        .form-card textarea:focus,
        .form-card select:focus {
            outline: none;
            border-color: #4f46e5;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

        .form-card input[type="checkbox"] {
            width: 18px;
            height: 18px;
            vertical-align: middle;
            accent-color: #4f46e5;
            cursor: pointer;
        }

        .form-card input[type="checkbox"] + label {
            display: inline;
            margin-left: 0.4em;
            vertical-align: middle;
            cursor: pointer;
        }

        .form-card ul {
            margin: 0 0 0.4em;
            padding: 0;
            list-style: none;
        }

        .form-card ul li {
            color: #b91c1c;
            font-size: 0.9em;
        }

        /* Bouton d'envoi */
        .form-card button[type="submit"] {
            width: 100%;
            padding: 0.8em;
            border: none;
            border-radius: 8px;
            background: #4f46e5;
            color: #fff;
            font-size: 1em;
            cursor: pointer;
            transition: background 0.2s;
        }

        .form-card button[type="submit"]:hover {
            background: #4338ca;
        }

        /* Lien retour */
        .back {
            display: inline-block;
            margin-top: 1.2em;
            color: #4f46e5;
            text-decoration: none;
        }

        .back:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
<div class="example-wrapper">
    <div class="form-card">

        <h1>Ajouter une citation</h1>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_row(form.texte) }}
            {{ form_row(form.auteur) }}
            {{ form_row(form.source) }}
            {{ form_row(form.categorie) }}
            {{ form_row(form.langue) }}
            {{ form_row(form.popularite) }}
            {{ form_row(form.favori) }}
        {{ form_end(form) }}

    </div>

    <a href="{{ path('citation_liste') }}" class="back">← Retour à la liste des citations</a>
</div>
{% endblock %}