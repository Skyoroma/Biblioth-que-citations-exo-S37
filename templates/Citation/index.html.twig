{% extends 'base.html.twig' %}

{% block stylesheets %}
{% endblock %}

{% block body %}
<style>
    .example-wrapper {
        margin: 1em auto;
        max-width: 800px; 
        width: 95%; 
        font: 18px/1.5 sans-serif; 
        background: #f5f5f5f3; 
    }
    .example-wrapper code { 
        background: #f5f5f5f3; 
        padding: 2px 6px; 
    }
    .citation {
        margin-bottom: 20px;
        padding: 15px;
        border: 1px solid #ccc;
        border-radius: 30px;
    }
</style>


<div class="example-wrapper">

    {% for citation in citations %}
        <div class="citation">
            <h2>{{ citation.texte }}</h2>
            <p>Auteur : {{ citation.auteur }}</p>
            <p>Source : {{ citation.source }}</p>
            <p>Ajouter le : {{ citation.dateAjout|date('d/m/Y') }}</p>
            <p>Categorie : {{ citation.categorie }}</p>
            <p>Langue : {{ citation.langue }}</p>
            <p>Popularite en étoile : {{ citation.popularite }}</p>
            {% if citation.favori > 0 %}
                <p>Favori</p>
            {% endif %}

            <form method="post"
                action="{{ path('app_products_delete', {id: product.id}) }}"
                onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                <button type="submit">Supprimer</button>
            </form>
        </div>
    {% else %}
        <p>Aucune citation en base.</p>
    {% endfor %}
</div>

{% endblock %}