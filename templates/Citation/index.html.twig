{% extends 'base.html.twig' %}

{% block title %}Mes citations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: #f0f2f5;
            margin: 0;
        }

        .example-wrapper {
            max-width: 800px;
            width: 95%;
            margin: 2em auto;
            font: 16px/1.5 system-ui, sans-serif;
            color: #333;
        }

        /* En-tête */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1em;
            margin-bottom: 1.5em;
        }

        .header h1 {
            margin: 0;
            font-size: 1.8em;
        }

        .btn {
            display: inline-block;
            padding: 0.6em 1.2em;
            border: none;
            border-radius: 8px;
            font-size: 0.95em;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s;
        }

        .btn-add {
            background: #4f46e5;
            color: #fff;
        }

        .btn-add:hover {
            background: #4338ca;
        }

        .btn-delete {
            background: #fee2e2;
            color: #b91c1c;
        }

        .btn-delete:hover {
            background: #fecaca;
        }

        .citation {
            position: relative;
            background: #fff;
            padding: 1.5em;
            margin-bottom: 1.2em;
            border-left: 5px solid #4f46e5;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .citation blockquote {
            margin: 0 0 0.8em;
            font-size: 1.3em;
            font-style: italic;
            font-family: Georgia, serif;
            color: #222;
        }

        .citation blockquote::before {
            content: "« ";
            color: #4f46e5;
        }

        .citation blockquote::after {
            content: " »";
            color: #4f46e5;
        }

        .auteur {
            margin: 0 0 1em;
            font-weight: bold;
            color: #555;
        }

        .auteur .source {
            font-weight: normal;
            color: #888;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5em;
            margin-bottom: 1em;
        }

        .tag {
            background: #eef2ff;
            color: #4338ca;
            padding: 0.2em 0.7em;
            border-radius: 20px;
            font-size: 0.85em;
        }

        .favori {
            position: absolute;
            top: 1em;
            right: 1em;
            background: #fef3c7;
            color: #b45309;
            padding: 0.2em 0.7em;
            border-radius: 20px;
            font-size: 0.85em;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5em;
            border-top: 1px solid #eee;
            padding-top: 0.8em;
        }

        .etoiles {
            color: #f59e0b;
            font-size: 1.2em;
            letter-spacing: 2px;
        }

        .date {
            font-size: 0.85em;
            color: #999;
        }

        .footer form {
            margin: 0;
        }

        .empty {
            text-align: center;
            color: #888;
            padding: 2em;
            background: #fff;
            border-radius: 10px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="example-wrapper">

    <div class="header">
        <h1>Mes citations</h1>
        <a href="{{ path('citation_add') }}" class="btn btn-add">+ Ajouter une citation</a>
    </div>

    {% for citation in citations %}
        <div class="citation">
            {% if citation.favori > 0 %}
                <span class="favori">★ Favori</span>
            {% endif %}

            <blockquote>{{ citation.texte }}</blockquote>

            <p class="auteur">
                — {{ citation.auteur }}
                {% if citation.source %}
                    <span class="source">, {{ citation.source }}</span>
                {% endif %}
            </p>

            <div class="tags">
                <span class="tag">{{ citation.categorie }}</span>
                <span class="tag">{{ citation.langue }}</span>
            </div>

            <div class="footer">
                <div>
                    <span class="etoiles">
                        {% for i in 1..5 %}{{ i <= citation.popularite ? '★' : '☆' }}{% endfor %}
                    </span>
                    <span class="date">Ajoutée le {{ citation.dateAjout|date('d/m/Y') }}</span>
                </div>

                <form method="post"
                      action="{{ path('app_citation_delete', {id: citation.id}) }}"
                      onsubmit="return confirm('Voulez-vous vraiment supprimer cette citation ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ citation.id) }}">
                    <button type="submit" class="btn btn-delete">Supprimer</button>
                </form>
            </div>
        </div>
    {% else %}
        <p class="empty">Aucune citation en base.</p>
    {% endfor %}
</div>
{% endblock %}