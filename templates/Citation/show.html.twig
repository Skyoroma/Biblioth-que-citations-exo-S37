
{% extends 'base.html.twig' %}

{% block body %}

<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    .product {
        margin-bottom: 20px;
        padding: 15px;
        border: 1px solid #ccc;
    }
</style>

<div class="example-wrapper">

    <h1>Citation Ajouter</h1>

    <h2>{{ citation.texte }}</h2>
    <p>Auteur : {{ citation.auteur }}</p>
    <p>Source : {{ citation.source }}</p>
    <p>Ajouter le : {{ citation.dateAjout|date('d/m/Y') }}</p>
    <p>Categorie : {{ citation.categorie }}</p>
    <p>Langue : {{ citation.langue }}</p>
    <p>Popularite en étoile : {{ citation.popularite }}</p>
    {% if citation.favori > 0 %}
        <p>Favoris</p>
    {% endif %}
    <a href="{{ path('citation_liste') }}">Retour à la liste</a>
</div>

{% endblock %}
